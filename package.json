{
  "name": "pi-pure",
  "version": "0.1.0",
  "description": "A set of simple pi extensions to provide an uncluttered experience.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@earendil-works/pi-tui": "^1.5.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/pure-editor.ts",
      "./extensions/pure-status.ts"
    ]
  }
}
